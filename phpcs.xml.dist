<?xml version="1.0"?>
<ruleset name="Static Maps API">
    <description>PSR-12 coding standard and PHP 8.1+ compatibility.</description>

    <file>include</file>
    <file>public</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <!-- Report warnings (line length, deprecations) without failing the run. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="PSR12">
        <!--
            Structural PSR-1 rules that need code to be reorganised rather than
            reformatted. Re-enable as the code is split up for the test suite (#14).
        -->
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
        <exclude name="PSR1.Classes.ClassDeclaration.MultipleClasses"/>
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
        <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>
    </rule>

    <config name="testVersion" value="8.1-"/>
    <rule ref="PHPCompatibility"/>
</ruleset>
