<?xml version="1.0"?>
<ruleset name="Static Maps API">
    <description>PSR-12 coding standard and PHP 8.1+ compatibility.</description>

    <file>include</file>
    <file>public</file>
    <file>config</file>
    <file>data/config.example.php</file>
    <file>tests</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <!-- Report warnings (line length, deprecations) without failing the run. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="PSR12"/>

    <!-- Tile URL templates in the config can't be wrapped. -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>config/defaults\.php</exclude-pattern>
    </rule>

    <config name="testVersion" value="8.1-"/>
    <rule ref="PHPCompatibility"/>
</ruleset>
